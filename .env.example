# Server-side TinyFish API key (keep server-side only; never expose to clients)
# Create a key at https://agent.tinyfish.ai/
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Comma-separated 32-character lowercase Chrome Extension IDs approved to access AheadGuard API.
# In Chrome: navigate to chrome://extensions, enable "Developer mode", and copy the 32-letter ID string.
# Example format: exactly 32 lowercase letters [a-z]
# For production: Add this in Vercel Dashboard -> Project Settings -> Environment Variables
ALLOWED_EXTENSION_IDS=abcdefghijklmnopqrstuvwxyzabcdef

# Neon Serverless Postgres Connection String (Application Runtime)
# Used by Next.js serverless functions for application queries.
# Uses the Neon Connection Pooler endpoint (contains "-pooler").
# Format: postgresql://[user]:[password]@[endpoint]-pooler.us-east-2.aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Dedicated Neon Migration Connection String (Direct Session Endpoint)
# Strictly required for running schema migrations (node scripts/migrate.mjs).
# Must NOT contain "-pooler" or "pgbouncer=true" because migrations require
# PostgreSQL session-level advisory locking (pg_advisory_lock) and session timeouts.
# Format: postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/[dbname]?sslmode=require
MIGRATION_DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Administrator Secret Key (Production)
# Used for querying stored investigation history (/api/investigate?action=history)
# and certifying live production persistence against canonical origin https://aheadguard-ai.vercel.app.
# Generate a cryptographically secure random secret (e.g. openssl rand -hex 32)
AHEADGUARD_ADMIN_KEY=your_secure_production_admin_secret_key_here

# Administrator Secret Key (Non-Production / Local / Staging Tests)
# Dedicated administrator secret for local development and non-production testing.
# Non-production verifications strictly require this key and prohibit transmission of the production key.
AHEADGUARD_TEST_ADMIN_KEY=your_secure_test_admin_secret_key_here
