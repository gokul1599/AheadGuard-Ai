# Server-side TinyFish API key (keep server-side only; never expose to clients)
# Create a key at https://agent.tinyfish.ai/
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Comma-separated 32-character lowercase Chrome Extension IDs approved to access AheadGuard API.
# In Chrome: navigate to chrome://extensions, enable "Developer mode", and copy the 32-letter ID string.
# Example format: exactly 32 lowercase letters [a-z]
# For production: Add this in Vercel Dashboard -> Project Settings -> Environment Variables
ALLOWED_EXTENSION_IDS=abcdefghijklmnopqrstuvwxyzabcdef
